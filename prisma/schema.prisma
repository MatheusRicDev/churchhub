generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Church {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  members  Member[]
  events   Event[]
  visitors Visitor[]
  familyRelations FamilyRelation[]
}

model User {
  id            String    @id @default(cuid())
  churchId      String
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  role          String    @default("ADMIN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  church   Church    @relation(fields: [churchId], references: [id])
  accounts Account[]
  sessions Session[]
}

model Member {
  id            String   @id @default(cuid())
  churchId      String
  name          String
  email         String?
  phone       String?
  phoneWhatsApp Boolean @default(false)
  birthDate   DateTime?
  gender      String?
  maritalStatus String?
  baptized    Boolean  @default(false)
  ministry      String?
  address     String?
  number      String?
  complement  String?
  city        String?
  state       String?
  notes       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  church      Church           @relation(fields: [churchId], references: [id])
  relationsFrom FamilyRelation[] @relation("MemberRelationsFrom")
  relationsTo   FamilyRelation[] @relation("MemberRelationsTo")
}

model FamilyRelation {
  id        String   @id @default(cuid())
  churchId  String
  fromId    String
  toId      String
  type      String
  createdAt DateTime @default(now())

  church Church @relation(fields: [churchId], references: [id])
  from   Member @relation("MemberRelationsFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Member @relation("MemberRelationsTo", fields: [toId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  churchId    String
  title       String
  description String?
  date        DateTime
  location    String?
  createdAt   DateTime @default(now())

  church Church @relation(fields: [churchId], references: [id])
}

model Visitor {
  id           String   @id @default(cuid())
  churchId     String
  name         String
  phone        String?
  phoneWhatsApp Boolean @default(false)
  invitedBy    String?
  address     String?
  number      String?
  city        String?
  state       String?
  firstVisit   DateTime @default(now())
  observations String?

  church Church @relation(fields: [churchId], references: [id])
}
